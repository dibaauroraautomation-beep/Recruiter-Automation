{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/pages/layout,_N_T_/pages/setting/layout,_N_T_/pages/setting/page,_N_T_/pages/setting"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/pages/setting/__PAGE__",
    "/pages/setting",
    "/pages",
    "/_index",
    "/_head"
  ]
}