{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/webhook/:path*",
        "destination": "http://localhost:5678/webhook/:path*",
        "regex": "^/webhook(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/drive",
      "regex": "^/api/drive(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive(?:/)?$"
    },
    {
      "page": "/api/drive/auth",
      "regex": "^/api/drive/auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/auth(?:/)?$"
    },
    {
      "page": "/api/drive/callback",
      "regex": "^/api/drive/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/drive/callback(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/pages/about",
      "regex": "^/pages/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/about(?:/)?$"
    },
    {
      "page": "/pages/candidate-ranking",
      "regex": "^/pages/candidate\\-ranking(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/candidate\\-ranking(?:/)?$"
    },
    {
      "page": "/pages/interview-evaluation",
      "regex": "^/pages/interview\\-evaluation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/interview\\-evaluation(?:/)?$"
    },
    {
      "page": "/pages/job-requisitions",
      "regex": "^/pages/job\\-requisitions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/job\\-requisitions(?:/)?$"
    },
    {
      "page": "/pages/login",
      "regex": "^/pages/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/login(?:/)?$"
    },
    {
      "page": "/pages/post-approval",
      "regex": "^/pages/post\\-approval(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/post\\-approval(?:/)?$"
    },
    {
      "page": "/pages/setting",
      "regex": "^/pages/setting(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/setting(?:/)?$"
    },
    {
      "page": "/pages/shortlisted-candidates",
      "regex": "^/pages/shortlisted\\-candidates(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pages/shortlisted\\-candidates(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}